{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "omniious.com" }], "destination": "https://www.omniious.com/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/proyectos/:slug", "destination": "/index.html" }
  ]
}
